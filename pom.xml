<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.geopolitica</groupId>
    <artifactId>geopolitica-parent</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>Geopolitica Parent</name>
    <description>Towns, states and nations for Paper/Spigot servers.</description>

    <modules>
        <module>geopolitica-api</module>
        <module>geopolitica-core</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>21</maven.compiler.release>

        <!--
            spigot-api is a minimum-version floor, not an exact pin: Bukkit/Spigot
            only add to the API surface across this range, they don't remove from
            it, and plugin.yml's api-version is likewise a floor. Compiling against
            the lowest version we claim to support (1.21) is therefore correct and
            keeps the plugin loadable on every server from 1.21 through the current
            26.x line (Mojang switched from the 1.21.x scheme to year-based
            versioning in 2026; 26.1/26.2/... is the same continuous version line,
            not a fork) and beyond. See geopolitica-core's README for the compile
            check against both ends of that range.
        -->
        <spigot.version>1.21-R0.1-SNAPSHOT</spigot.version>
        <hikaricp.version>5.1.0</hikaricp.version>
        <sqlite-jdbc.version>3.46.1.3</sqlite-jdbc.version>
        <mysql-connector-j.version>26.7.0</mysql-connector-j.version>
    </properties>

    <repositories>
        <repository>
            <id>spigotmc-snapshots</id>
            <url>https://hub.spigotmc.org/nexus/content/repositories/snapshots/</url>
        </repository>
    </repositories>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.15.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-shade-plugin</artifactId>
                    <version>3.6.2</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
